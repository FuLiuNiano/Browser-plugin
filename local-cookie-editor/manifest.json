{
  "manifest_version": 3,
  "name": "本地 Cookie 编辑器",
  "version": "1.0.0",
  "description": "纯本地 Cookie 查看/导出 JSON/导入：零联网代码、按站点授权、无后台进程。数据只去屏幕、剪贴板和本地文件。",
  "minimum_chrome_version": "102",
  "permissions": ["cookies", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "本地 Cookie 编辑器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
